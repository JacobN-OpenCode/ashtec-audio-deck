{
  "name": "ashtec-audio-deck",
  "productName": "AshTec Audio Deck",
  "version": "1.2.0",
  "description": "A simple audio playback deck for AshTec shows: queue audio files, pick your speakers, press start.",
  "main": "electron/main.js",
  "author": "Jacob N (AshTec Crew)",
  "license": "MIT",
  "homepage": "https://github.com/JacobN-OpenCode/ashtec-audio-deck",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "uk.navaratne.ashtec.audiodeck",
    "productName": "AshTec Audio Deck",
    "copyright": "© AshTec Crew",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "portable": {
      "artifactName": "AshTec-Audio-Deck-${version}.exe"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "identity": null,
      "target": [{ "target": "dmg", "arch": ["universal"] }]
    },
    "dmg": {
      "artifactName": "AshTec-Audio-Deck-${version}.dmg",
      "title": "AshTec Audio Deck",
      "contents": [
        { "x": 180, "y": 170 },
        { "x": 480, "y": 170, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
